# Copy this file to .env (in the project root, alongside server.js and
# package.json) to override defaults. All values are read with sane
# offline defaults, so this file is optional.

# Port the QR microservice listens on. The FastAPI backend's
# QR_SERVICE_BASE_URL (see .env.template) must point at this port.
QR_SERVICE_PORT=4000

# How long a generated QR stays valid before the countdown timer on the
# frontend expires it. Independent of the Python-side
# QR_PAYLOAD_TTL_SECONDS, but should normally be kept in sync.
QR_DEFAULT_TTL_SECONDS=900

# Default QR image dimensions (pixels, square) and error-correction level.
# ECC levels: L (7%), M (15%), Q (25%), H (30%). Higher ECC survives more
# damage/logo overlay at the cost of a denser pattern.
QR_DEFAULT_SIZE_PX=300
QR_DEFAULT_ECC_LEVEL=M

# In-memory cache time-to-live (seconds) for repeated identical requests
# (same payload hash) — avoids re-encoding the same QR on every poll.
QR_CACHE_TTL_SECONDS=120
